# Copy to .env (gitignored) and paste the OpenAI API key after the =, no
# quotes needed. The CLI and the eval runner read .env automatically on
# startup; an exported shell variable wins over anything set here.

OPENAI_API_KEY=
ABBIE_MODEL=gpt-5-mini

# Tracing is optional. With none of the below set, the pipeline runs unchanged
# and spans are discarded, so a laptop needs no account and no keys.
#
# Langfuse keys authenticate over OTLP/HTTP. Any other OTLP collector works
# instead via OTEL_EXPORTER_OTLP_ENDPOINT, which is what keeps the backend a
# configuration choice rather than a code change.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Off by default. Prompts and replies carry whatever a visitor typed, so
# recording them is a decision about storing personal data rather than a
# debugging convenience. Blocked turns are the case that most justifies it.
# ABBIE_TRACE_CONTENT=true
