# Local credentials and connection configuration
.env
.env.*
*.env
!.env.example
*.local.env
.pgpass
*.pem
*.key
config/benchling.local.json

# Warehouse audit output
schema-audit/
*.schema.tsv

# Internal IPI reference material: unpublished draft manuscript, SOPs, meeting notes
# with staff contact details. Reference only, never distributed with the repo.
answer_references/

# Planning and design documents. Working drafts that change faster than the code
# they describe, kept local rather than carried by the repo.
/roadmap.md
/architecture.md
/hosting-decision.md
/warehouse-findings.md
/chatbot-proposal.md
/abbie-widget-handoff/SPEC.md
/demo-runbook.md

# Eval runs reference commit SHAs; promoting one to a committed baseline is deliberate
packages/eval/results/
packages/eval/.cache/

# Datasheet ingest output. Rebuilt from the public website by
# scripts/ingest_datasheets.py, so the run is reproducible without carrying it.
packages/catalog/extract/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# macOS and editor files
.DS_Store
.vscode/
.idea/
.claude/settings.local.json

# Closed-access source PDFs, retrieved under institutional licence. Never committed.
sources/*
!sources/README.md
